# --- PostgreSQL ---
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fleet_manager
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend security ---
# openssl rand -hex 32
JWT_SECRET_KEY=change-me-jwt-secret-please-generate-a-real-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting stored credentials — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-a-fernet-key

TOTP_ISSUER_NAME=FleetManager

# --- Вход доменной учётной записью (README → «Вход доменной учётной записью») ---
# Значения до первого сохранения в интерфейсе (Администрирование → «Вход через домен»), потом действуют те.
LDAP_ENABLED=false
LDAP_URL=ldaps://at.urfu.ru
LDAP_DOMAIN=at.urfu.ru
LDAP_BASE_DN=DC=at,DC=urfu,DC=ru
# Группы ролей: DN через «;». Без групп через домен не входит никто.
LDAP_ADMIN_GROUPS=
LDAP_OPERATOR_GROUPS=
LDAP_VIEWER_GROUPS=
# Короткое имя домена для входа на ПК от имени инициатора плейбука (AT\логин)
LDAP_NETBIOS_DOMAIN=AT
# Плейбуки от имени доменного инициатора (README → «От чьего имени выполняются плейбуки»)
PLAYBOOK_RUN_AS_INITIATOR=true
# Служебная запись только для чтения: перепроверка доступа при обновлении токена
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# --- Ansible ---
ANSIBLE_PLAYBOOKS_REPO_DIR=/app/ansible_data/playbooks_repo
ANSIBLE_PRIVATE_KEY_DIR=/app/ansible_data/keys
# Плейбуки из редактора (только на этом сервере, не в git)
LOCAL_PLAYBOOKS_DIR=/app/ansible_data/local_playbooks
# Сколько ПК одна задача (обновление агента, проверка версий, сканирование ПО) обрабатывает
# одновременно. Плейбуки параллелит сам Ansible (ANSIBLE_FORKS).
HOST_TASK_PARALLELISM=10

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,https://localhost

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- HTTPS (frontend/nginx) ---
# Сайт открывается по https://<сервер> (443), с 80 — перенаправление. Сертификат —
# certs/fleet.crt + certs/fleet.key; пока их нет, генерируется самоподписанный
# с этими именами (subjectAltName). Порт 8080 остаётся HTTP-адресом API для агентов.
TLS_SELF_SIGNED_SAN=IP:127.0.0.1,DNS:localhost
