# --- PostgreSQL ---
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=fleet_manager
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend security ---
# openssl rand -hex 32
JWT_SECRET_KEY=change-me-jwt-secret-please-generate-a-real-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting stored credentials — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-a-fernet-key

TOTP_ISSUER_NAME=FleetManager

# --- Ansible ---
ANSIBLE_PLAYBOOKS_REPO_DIR=/app/ansible_data/playbooks_repo
ANSIBLE_PRIVATE_KEY_DIR=/app/ansible_data/keys

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
